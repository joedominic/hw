# Copy to JobApp-Jules/.env and adjust for your environment.
# Docker Compose loads this file via env_file (optional; copy to .env before compose up).

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SHOW_DEV_TOOLS=True
# Production fail-closed safety overrides (default False):
# ALLOW_SQLITE_IN_PRODUCTION=False
# ALLOW_CONSOLE_EMAIL_IN_PRODUCTION=False
# ALLOW_EMPTY_STRIPE_WEBHOOK_SECRET=False
# Default experience for new signups: normal (job seeker) or power (builder/advanced)
# DEFAULT_EXPERIENCE_MODE=normal
# SIGNUP_ENABLED=True
# REQUIRE_EMAIL_VERIFICATION=False

# --- Database (MySQL / MariaDB) ---
# When MYSQL_DATABASE is set, Django uses MySQL instead of local SQLite.
# manage.py test still uses SQLite unless MYSQL_USE_FOR_TESTS=1.
# Use a dedicated, least-privilege user scoped to this one DB (see ops/mariadb/provision.sql).
# MYSQL_DATABASE=resxjob
# MYSQL_USER=resxapp
# MYSQL_PASSWORD=
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_CONN_MAX_AGE=60
# MYSQL_CONN_HEALTH_CHECKS=True
# Test/scratch DB name (Django default is test_<MYSQL_DATABASE>); needs its own grant.
# MYSQL_TEST_DATABASE=test_resxjob
# TLS: the server negotiates encryption by default. Set a CA path for VERIFIED TLS,
# or MYSQL_SSL_DISABLED=1 to force plaintext (e.g. local unix socket).
# MYSQL_SSL_CA=/etc/ssl/certs/mariadb-ca.pem
# MYSQL_SSL_VERIFY_IDENTITY=True
# MYSQL_SSL_DISABLED=False
# Native dump binary for `manage.py dbbackup` (auto-detected; override if needed).
# MYSQL_DUMP_BIN=mariadb-dump
# One-time SQLite → MySQL copy (after migrate on empty MySQL):
#   python manage.py copy_sqlite_to_mysql
# Backup / restore:
#   python manage.py dbbackup                    # -> django_project/backups/*.sql.gz
#   python manage.py dbrestore <dump> --verify   # restores into MYSQL_TEST_DATABASE

# --- SaaS / billing / quotas ---
# SAAS_DEFAULT_PLAN_SLUG=free
# SAAS_ENFORCE_QUOTAS=True
# Staff/superuser skip quotas only when explicitly enabled (default off)
# SAAS_STAFF_BYPASS_QUOTAS=False
# SAAS_PAST_DUE_GRACE_DAYS=5
# Daily cloud token budgets by plan slug
# LLM_DAILY_TOKEN_LIMIT_FREE=50000
# LLM_DAILY_TOKEN_LIMIT_PRO=2000000
# LLM_DAILY_TOKEN_LIMIT_POWER=10000000
# LLM_DAILY_TOKEN_LIMIT_UNLIMITED=10000000
# Universal emergency ceiling across all plans (0 = disabled)
# LLM_USER_DAILY_TOKEN_LIMIT=0
# Require Bring-Your-Own-Key (BYOK) for programmatic POST /api/resume/llm/complete on Pro
# LLM_COMPLETE_REQUIRE_BYOK_FOR_PRO=True
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# Link Plan.stripe_price_id in admin to Stripe Price IDs

# --- Abuse throttling ---
# ABUSE_THROTTLE_ENABLED=True
# ABUSE_AUTH_LIMIT=20
# ABUSE_API_LIMIT=120
# Shared cache for multi-worker abuse limits (auto Redis when DEBUG=False)
# DJANGO_CACHE_USE_REDIS=True
# DJANGO_CACHE_URL=redis://127.0.0.1:6379/1
# DJANGO_CACHE_REDIS_DB=1

# --- Encryption key rotation (optional; newest first, comma-separated Fernet keys) ---
# FERNET_KEYS=

# --- Production HTTPS (auto-on when DEBUG=False) ---
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# CSRF_TRUSTED_ORIGINS=https://app.example.com

# --- Optional S3 media ---
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_QUERYSTRING_AUTH=True
# AWS_QUERYSTRING_EXPIRE=120

# --- Email (password reset + verification; console backend prints to stdout) ---
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=HireEdge <noreply@example.com>
# ACCOUNT_EMAIL_BASE_URL=http://127.0.0.1:8000
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- Huey / Redis broker (shared by Huey, cache/abuse-throttle, and LLM limits) ---
# Unique per checkout when sharing Redis with another JobApp clone (e.g. Jules).
HUEY_NAME=jobapp-main
# Default is localhost. Point at your broker host; keep it on a private network.
HUEY_REDIS_HOST=127.0.0.1
# Prefer a dedicated Redis for JobApp-Main (e.g. 6380) so other apps on 6379 stay isolated.
HUEY_REDIS_PORT=6380
HUEY_REDIS_DB=0
# STRONGLY recommended on any shared/LAN Redis: require AUTH. Applies to Huey,
# Django cache, and the LLM rate limiter (single shared credential).
# Task results are pickled; write access to Redis is effectively code execution.
# REDIS_PASSWORD=
# Set when the broker terminates TLS (uses rediss://).
# REDIS_USE_TLS=False
# Task result TTL (RedisExpireHuey). Results self-expire instead of growing forever.
# HUEY_RESULT_EXPIRE_SECONDS=86400
# Set to 1 only for single-process dev without Redis (disables periodic scheduler).
# HUEY_IMMEDIATE=0

# If Redis runs on the Docker host machine (not another LAN host), use instead:
# HUEY_REDIS_HOST=host.docker.internal

# Apply agent (browser automation)
# APPLY_USE_MOCK_RESOLVER=0
# APPLY_BROWSER_HEADLESS=1
# APPLY_BROWSER_CONCURRENCY=2
# APPLY_BROWSER_STEP_TIMEOUT_SECONDS=360

# --- Job search: Adzuna API (https://developer.adzuna.com/) — required when Adzuna is selected as a source ---
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=us
# ADZUNA_MAX_PAGES=3

# --- Job search: Dice (optional; defaults to the public browser API key used by dice.com) ---
# DICE_API_KEY=
# DICE_COUNTRY_CODE=US
# DICE_RADIUS_MILES=30

# --- Job search: Levels.fyi (undocumented encrypted API used by levels.fyi/jobs) ---
# LEVELS_FYI_STANDARD_LEVELS=principal,director,mid_staff,manager
# LEVELS_FYI_OFFSET_STEP=10
# LEVELS_FYI_PAGE_DELAY=0.35
# LEVELS_FYI_MAX_SCAN_PAGES=30

# --- Job source resilience & circuit breakers ---
# Comma-separated list of boards disabled by administrator (e.g. "levels,greenhouse")
# DISABLED_JOB_SOURCES=
# Consecutive failures before tripping a source circuit breaker to OPEN (default: 3)
# JOB_SOURCE_CB_FAILURE_THRESHOLD=3
# Cooldown period in seconds before testing a tripped source with a probe (default: 180)
# JOB_SOURCE_CB_COOLDOWN_SECONDS=180

# --- Optional API security ---
# API_ACCESS_TOKEN=

# --- LLM provider keys (optional env fallbacks; DB-stored keys preferred) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# GOOGLE_API_KEY=

# --- Langfuse LLM Observability & Telemetry (https://cloud.langfuse.com) ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_ENABLED=True
# LANGFUSE_MASK_PII=True
# In production (DEBUG=False), LANGFUSE_REDACT_CONTENT defaults to True (metadata-only telemetry; zero prompt/response leakage).
# Set LANGFUSE_EXPORT_PROMPT_CONTENT=True only if full prompt transparency in Langfuse Cloud is explicitly authorized.
# LANGFUSE_REDACT_CONTENT=True
# LANGFUSE_EXPORT_PROMPT_CONTENT=False

# --- OpenTelemetry (Vendor-Agnostic Tracing & Observability) ---
# Disabled by default (zero runtime or network overhead when False).
# Compatible with SigNoz, Grafana Tempo, Datadog, Honeycomb, or AWS X-Ray.
# OTEL_ENABLED=False
# OTEL_SERVICE_NAME=hireedge-web
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_HEADERS=
# Injects active OTel trace IDs into downstream Langfuse LLM generation metadata.

# --- Automated Backups & Disaster Recovery ---
# BACKUP_DIR=django_project/backups
# BACKUP_RETENTION_DAYS=30
# BACKUP_ENCRYPTION_PASSPHRASE=

# --- LLM rate limits / budgets (shared Redis; see core/settings.py) ---
# LLM_RATE_LIMIT_ENABLED=True
# Fail-open defaults to DEBUG (fail-closed when DEBUG=False)
# LLM_RATE_LIMIT_FAIL_OPEN=False
# LLM_RATE_LIMIT_REDIS_URL=
# LLM_RATE_LIMIT_OPENAI_RPM=60
# LLM_RATE_LIMIT_OPENAI_TPM=90000
# LLM_DAILY_TOKEN_LIMIT_FREE=200000
# LLM_DAILY_TOKEN_LIMIT_PRO=2000000
# LLM_PLATFORM_DAILY_TOKEN_LIMIT=5000000
# LLM_INVOKE_TIMEOUT_SECONDS=480
# LLM_USER_MAX_CONCURRENT=2
# LLM_COMPLETE_MAX_INPUT_CHARS=16000

# --- Optimizer token budgets & LLM routing ---
# By default Writer + judges use remote/cloud LLMs whenever configured (local Ollama is failover).
# Set OPTIMIZER_JUDGES_PREFER_LOCAL=True to prefer an is_local preference row for ATS/Recruiter only.
# OPTIMIZER_JUDGES_PREFER_LOCAL=False
# OPTIMIZER_JUDGE_RESUME_MAX_CHARS=12000
# OPTIMIZER_JUDGE_JD_MAX_CHARS=8000
# OPTIMIZER_USE_ROLE_SLICE_FOR_WRITER_JD=True
# OPTIMIZER_WRITER_RESUME_MAX_CHARS=14000
# OPTIMIZER_SOURCE_RESUME_MAX_CHARS=12000
# Enable Ollama model think/reasoning mode (allows Nemotron/R1 models full chain-of-thought scratchpad)
OLLAMA_ENABLE_THINKING=True
# Skill Radar (Interview Fit & Skill Diagnostics) character limits
# SKILL_RADAR_RESUME_MAX_CHARS=12000
# SKILL_RADAR_JD_MAX_CHARS=10000
